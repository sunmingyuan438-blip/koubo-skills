{
 "id": "timestamp-day",
 "title": "一天时间线",
 "canvas": "portrait",
 "fit": "cover",
 "grade": {
  "vf": "eq=contrast=1.03:saturation=0.95:gamma=1.01,colorbalance=rs=-0.02:bs=0.03:rh=-0.01:bh=0.02",
  "hdr_vf": "eq=saturation=0.97"
 },
 "transition": {
  "default": "cut",
  "dur": 0.25
 },
 "pace": {
  "auto": true,
  "snap": 1,
  "base": 1.6,
  "pattern": [
   1.0,
   0.55,
   1.3,
   0.6,
   1.8,
   0.5
  ],
  "breath": 2.4,
  "hook": 0.6,
  "min": 0.45,
  "max": 3.0,
  "text_min": 0.9
 },
 "music_preset": "tick",
 "audio": {
  "clip": 0.3,
  "music": 0.75,
  "vo": 1.0,
  "duck": true,
  "lufs": -14
 },
 "clip_text": {
  "stamp_caption": {
   "needs": "stamp,text",
   "anim": {
    "kind": "rise",
    "dur": 0.3
   }
  },
  "caption": {
   "needs": "text",
   "unless": "stamp"
  }
 },
 "persistent": [
  {
   "id": "rec",
   "template": "rec",
   "from": 0,
   "tail": 0
  }
 ],
 "templates": {
  "stamp_caption": [
   {
    "text": "{stamp}",
    "font": "din",
    "size": 0.085,
    "y": 0.44,
    "shadow": 0.6
   },
   {
    "text": "{text}",
    "font": "noto:Medium",
    "size": 0.034,
    "y": 0.5,
    "shadow": 0.6,
    "maxw": 0.82
   }
  ],
  "caption": [
   {
    "text": "{text}",
    "font": "noto:Medium",
    "size": 0.034,
    "y": 0.5,
    "shadow": 0.6,
    "maxw": 0.82
   }
  ],
  "rec": [
   {
    "shape": "circle",
    "circle": [
     0.075,
     0.068,
     0.009
    ],
    "color": "#ff3b30"
   },
   {
    "text": "REC  {date}",
    "font": "menlo-bold",
    "size": 0.024,
    "x": 0.095,
    "y": 0.068,
    "anchor": "left",
    "shadow": 0.5
   }
  ],
  "opener": {
   "layers": [
    {
     "text": "{text}",
     "font": "din",
     "size": 0.11,
     "y": 0.47,
     "shadow": 0.7,
     "tracking": 0.04
    },
    {
     "text": "{sub}",
     "font": "noto:Medium",
     "size": 0.034,
     "y": 0.535,
     "shadow": 0.6,
     "when": "sub"
    }
   ],
   "anim": {
    "kind": "type",
    "field": "text",
    "cps": 16
   }
  }
 },
 "jianying": {
  "filter": [
   "冷白",
   40
  ],
  "text": {
   "font": "SourceHanSansCN_Medium",
   "templates": {
    "stamp_caption": {
     "text": "{stamp}\n{text}",
     "size": 6.0,
     "y": 0.47,
     "shadow": 0.6,
     "intro": "渐显"
    },
    "caption": {
     "text": "{text}",
     "size": 5.67,
     "y": 0.5,
     "shadow": 0.6
    }
   }
  }
 }
}